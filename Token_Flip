@echo off
setlocal EnableDelayedExpansion

:loop
cls
echo =====================================
echo             RSA TOKEN
echo =====================================
echo.

:: Generate a 7-digit token
set /a token=%random% * 327 + %random%
set /a token=token %% 9000000 + 1000000

echo Current token:
echo !token!
echo.
echo Next update in 30 seconds...

timeout /t 30 >nul
goto loop
