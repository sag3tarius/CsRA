using System;
using System.Threading;
using System.Diagnostics;

class Program
{
    static void Main()
    {
        bool interactive = IsInteractive();

        if (interactive)
        {
            Console.Clear();
            Console.WriteLine("=====================================");
            Console.WriteLine("      ДОНОВСКИЙ RSA-ТОКЕН");
            Console.WriteLine("=====================================");
            Console.WriteLine("");
        }

        while (true)
        {
            int token = new Random().Next(1000000, 9999999);

            if (interactive)
            {
                Console.Clear();
                Console.WriteLine("=====================================");
                Console.WriteLine("      ДОНОВСКИЙ RSA-ТОКЕН");
                Console.WriteLine("=====================================");
                Console.WriteLine("");

                Console.ForegroundColor = ConsoleColor.Cyan;
                Console.WriteLine("Текущий токен:");

                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine(token);
                Console.ResetColor();
                Console.WriteLine("");

                Console.ForegroundColor = ConsoleColor.Yellow;
                Console.WriteLine("Следующее обновление через 30 секунд...");
                Console.ResetColor();
            }

            Thread.Sleep(30000);
        }
    }

    static bool IsInteractive()
    {
        // Detect if program is running inside an interactive console
        return Environment.UserInteractive;
    }
}
