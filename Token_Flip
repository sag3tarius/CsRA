@echo off
chcp 65001 >nul
setlocal EnableDelayedExpansion

:loop
cls
echo =====================================
echo       ДОНОВСКИЙ RSA-ТОКЕН
echo =====================================
echo.

set /a token=%random% * 327 + %random%
set /a token=token %% 9000000 + 1000000

echo Текущий токен:
echo !token!
echo.
echo Следующее обновление через 30 секунд...

timeout /t 30 >nul
goto loop
