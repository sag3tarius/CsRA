Clear-Host

Write-Host "====================================="
Write-Host "      DONOVIAN RSA TOKEN DEVICE"
Write-Host "====================================="
Write-Host ""

function New-Token {
    # Generate random 7 digit number
    return Get-Random -Minimum 1000000 -Maximum 9999999
}

while ($true) {

    $token = New-Token
    
    Clear-Host
    Write-Host "====================================="
    Write-Host "      DONOVIAN RSA TOKEN DEVICE"
    Write-Host "====================================="
    Write-Host ""
    
    Write-Host "Current Token:" -ForegroundColor Cyan
    Write-Host $token -ForegroundColor Green
    Write-Host ""
    Write-Host "Next code in 30 seconds..." -ForegroundColor Yellow

    Start-Sleep -Seconds 30
}
