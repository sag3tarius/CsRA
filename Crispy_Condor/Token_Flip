@echo off
setlocal EnableDelayedExpansion

:loop
cls
echo =====================================
echo             RSA TOKEN
echo =====================================
echo.

for /f %%A in (C:\TokenService\current_token.txt) do set token=%%A

echo Current token:
echo !token!
echo.
echo Next update in 30 seconds...

timeout /t 30 >nul
goto loop
