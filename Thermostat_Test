import tkinter as tk
from tkinter import ttk
import math

class ThermostatGUI:
    def __init__(self, root):
        self.root = root
        self.root.title("Thermostat Dial")

        # Data
        self.outside_temp = 92
        self.current_setting = 72
        self.mode = "Cooling"

        # Canvas for dial
        self.canvas = tk.Canvas(root, width=300, height=300, bg="white", highlightthickness=0)
        self.canvas.pack(pady=10)

        # Labels
        self.outside_label = ttk.Label(root, text=f"Outside Temperature: {self.outside_temp}°F", font=("Arial", 16))
        self.outside_label.pack(pady=5)

        self.mode_label = ttk.Label(root, text=f"Current Mode: {self.mode}", font=("Arial", 16))
        self.mode_label.pack(pady=5)

        # Mode buttons
        mode_frame = ttk.Frame(root)
        mode_frame.pack(pady=10)

        ttk.Label(mode_frame, text="Mode:", font=("Arial", 16)).grid(row=0, column=0, padx=10)
        ttk.Button(mode_frame, text="Heating", command=lambda: self.set_mode("Heating")).grid(row=0, column=1, padx=10)
        ttk.Button(mode_frame, text="Cooling", command=lambda: self.set_mode("Cooling")).grid(row=0, column=2, padx=10)

        # Draw dial initially
        self.draw_dial()

        # Mouse events for rotating the dial
        self.canvas.bind("<ButtonPress-1>", self.start_rotate)
        self.canvas.bind("<B1-Motion>", self.rotate)

        self.last_angle = None

    def draw_ticks(self):
        center_x, center_y = 150, 150
        radius_outer = 110
        radius_inner = 95

        # Small tick marks (every 6 degrees)
        for angle in range(0, 360, 6):
            rad = math.radians(angle)
            x_outer = center_x + radius_outer * math.cos(rad)
            y_outer = center_y - radius_outer * math.sin(rad)
            x_inner = center_x + radius_inner * math.cos(rad)
            y_inner = center_y - radius_inner * math.sin(rad)
